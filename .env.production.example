# Modèle d'environnement de PRODUCTION (docker-compose.prod.yml).
# cp .env.production.example .env.production — .env.production est ignoré par git.

APP_NAME=Muse
APP_ENV=production
# Générer avec : php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
APP_KEY=
APP_DEBUG=false
APP_URL=https://muse.exemple.com
APP_PORT=80

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_CA

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# stderr : les logs apparaissent dans `docker compose logs` au lieu de rester dans le conteneur.
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# DB_HOST = nom du service MySQL dans docker-compose.prod.yml.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=muse
DB_USERNAME=muse
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Doit dépasser le --timeout du worker (900 s), sinon un job long est relancé en double.
DB_QUEUE_RETRY_AFTER=960
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@exemple.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Whisper est installé dans l'image ; le modèle est téléchargé au premier usage (volume whisper_models).
WHISPER_MODEL=small

# Optionnel — génération de sous-questions par IA (GenerateSousQuestionsAction).
OPENAI_API_KEY=
